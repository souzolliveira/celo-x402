# Celo mainnet. The tag and suffix come from `loops project get --event agents-on-open-rails`.
CELO_CHAIN_ID=42220
CELO_ATTRIBUTION_TAG=
CELO_DATA_SUFFIX=
AGENT_WALLET_ADDRESS=

# Privy. The app id is public. The secret stays on the server.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=

# Local Mongo from docker compose. API keys are stored as HMAC hashes with this pepper.
MONGODB_URI=mongodb://127.0.0.1:27017/gateway
API_KEY_PEPPER=
CALL_MAX_USD=2
